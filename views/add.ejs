<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container" style="max-width: 600px;">
    <h2>Tambah Menu Baru</h2>
    
    <form action="/menu/add" method="POST" style="background: white; padding: 25px; border-radius: 12px; border: 1px solid #f0e2d5;">
      <div style="margin-bottom: 15px;">
        <label style="display: block; font-weight: bold; margin-bottom: 5px;">Nama Menu:</label>
        <input type="text" name="nama" required style="width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #ccc; box-sizing: border-box;">
      </div>

      <div style="margin-bottom: 15px;">
        <label style="display: block; font-weight: bold; margin-bottom: 5px;">Kategori:</label>
        <select name="kategori" required style="width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #ccc; box-sizing: border-box;">
          <option value="kopi">Kopi</option>
          <option value="non-kopi">Non-Kopi</option>
          <option value="makanan">Makanan</option>
        </select>
      </div>

      <div style="margin-bottom: 15px;">
        <label style="display: block; font-weight: bold; margin-bottom: 5px;">Harga (Rp):</label>
        <input type="number" name="harga" required style="width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #ccc; box-sizing: border-box;">
      </div>

      <div style="margin-bottom: 15px;">
        <label style="display: block; font-weight: bold; margin-bottom: 5px;">Deskripsi:</label>
        <textarea name="deskripsi" rows="3" style="width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #ccc; box-sizing: border-box;"></textarea>
      </div>

      <div style="margin-bottom: 20px;">
        <label style="display: block; font-weight: bold; margin-bottom: 5px;">Path Gambar (contoh: /images/americano.webp):</label>
        <input type="text" name="gambar" placeholder="/images/default.webp" style="width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #ccc; box-sizing: border-box;">
      </div>

      <div style="display: flex; gap: 10px;">
        <button type="submit" class="btn" style="background-color: #28a745; border: none; cursor: pointer;">Simpan Data</button>
        <a href="/" class="btn" style="background-color: #6c757d;">Batal</a>
      </div>
    </form>
  </div>

  <%- include('partials/footer') %>
</body>
</html>