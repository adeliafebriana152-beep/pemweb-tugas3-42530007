<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h1>Menu Sore di Bali Cafe</h1>
      <!-- Tombol Tambah Menu Baru -->
      <a href="/menu/add" class="btn" style="background-color: #28a745;">+ Tambah Menu Baru</a>
    </div>

    <!-- Filter Kategori -->
    <div class="filter-box">
      <span>Filter Kategori: </span>
      <a href="/" class="<%= selectedKategori === 'semua' ? 'active' : '' %>">Semua</a>
      <a href="/?kategori=kopi" class="<%= selectedKategori === 'kopi' ? 'active' : '' %>">Kopi</a>
      <a href="/?kategori=non-kopi" class="<%= selectedKategori === 'non-kopi' ? 'active' : '' %>">Non-Kopi</a>
      <a href="/?kategori=makanan" class="<%= selectedKategori === 'makanan' ? 'active' : '' %>">Makanan</a>
    </div>

    <!-- Grid Kartu Menu -->
    <div class="grid">
      <% if (menus.length > 0) { %>
        <% menus.forEach(item => { %>
          <div class="card">
            <img src="<%= item.gambar %>" alt="<%= item.nama %>">
            <h3><%= item.nama %></h3>
            <p>Rp <%= item.harga.toLocaleString('id-ID') %></p>
            
            <div style="margin-top: 10px; display: flex; gap: 5px; justify-content: center; flex-wrap: wrap;">
              <a href="/menu/<%= item.id %>" class="btn">Detail</a>
              <a href="/menu/edit/<%= item.id %>" class="btn" style="background-color: #ffc107; color: #000;">Edit</a>
              
              <!-- Form Hapus Menu (POST Method + PRG Pattern) -->
              <form action="/menu/delete/<%= item.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Apakah Anda yakin ingin menghapus menu ini?');">
                <button type="submit" class="btn" style="background-color: #dc3545; border: none; cursor: pointer;">Hapus</button>
              </form>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p>Menu tidak ditemukan untuk kategori ini.</p>
      <% } %>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>